{
  "name": "hivaware",
  "version": "2.2.0",
  "type": "module",
  "description": "HIV education and awareness application",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stevederico/HIVAware.git"
  },
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "serve": "vite --force --mode development",
    "start": "vite --force --mode development",
    "build": "npm run typecheck && vite build --mode production",
    "verify:ui": "node scripts/verify-ui-version.mjs",
    "front": "vite --force --mode development",
    "server": "npm run --workspace=backend dev",
    "prod": "npm run typecheck && vite build --mode production",
    "install-all": "npm install && npm install --workspace=backend",
    "postinstall": "git config core.hooksPath .githooks || true",
    "test": "npm run typecheck && npm run --workspace=backend test",
    "test:watch": "npm run --workspace=backend test:watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p backend/tsconfig.json"
  },
  "dependencies": {
    "@stevederico/skateboard-ui": "3.12.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.0",
    "use-sync-external-store": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "tailwindcss": "4.1.18",
    "typescript": "6.0.3",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "skateboardVersion": "3.9.0"
}
